# 秦川系统账号
USERNAME=请填写账号
PASSWORD=请填写密码

# 排产、报工时的指派人，必须与系统里的姓名一致
ASSIGNEE=请填写姓名

# 任务日期，格式 YYYY-MM-DD；留空时使用运行当天
TASK_DATE=

# 任务模板文件名，可选值见 template 目录；留空时使用父任务模板
TASK_TEMPLATE=开发任务填报-父任务模版.md

# 报工说明最大字符数，包含编号、标点和换行；留空时默认 60
WORK_DESCRIPTION_MAX_LENGTH=60

# Git 仓库扫描根目录，会递归读取其中各仓库的指定日期提交
REPO_ROOT=F:\workspace\qc\296

# 登录成功后进入的项目名称，必须与顶部项目列表中的名称完全一致
PROJECT=请填写项目名称

# 模型来源：qoder、openai、anthropic。留空时使用 qoder
MODEL_PROVIDER=qoder
MODEL=
MODEL_BASE_URL=
MODEL_API_KEY=
